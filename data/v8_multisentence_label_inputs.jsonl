{"id": "v8-multi-037-zh-CN", "group_id": "v8-multi-037", "category": "hard", "input": {"text": "He gave us the cold shoulder. Neither of our questions received a reply.", "target_lang": "zh-CN", "context": "The person ignored the speakers; shoulder is part of an idiom.", "glossary": {}}, "source": {"name": "Original Codex-authored multi-sentence training paragraphs", "license": "Original synthetic project data", "training_allowed": true, "external_labeling_allowed": true}}
